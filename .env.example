# === Required ===
DB_PASSWORD=changeme_strong_password_here
FIRMWARE_ANALYZER_TOKEN=

# === Network Scanning ===
NETWORK_CIDR=192.168.1.0/24

# === Authentication (JWT) ===
# RSA private key (inline PEM). Leave both empty and the process generates a
# throwaway key at startup. That is only safe for ONE local instance: an
# auto-generated key is not shared, so with two or more replicas tokens issued
# by one are rejected by the others, and every restart invalidates all sessions.
# Generate one with:  openssl genrsa 2048 | tee jwt-private.pem
JWT_SECRET=
# Or path to a PEM file on disk. If this is set but unreadable the process
# refuses to start rather than silently falling back to a generated key.
JWT_PRIVATE_KEY_FILE=
# Set to true for any multi-replica deployment: refuse to boot when no signing
# key is configured. The Kubernetes manifest sets this.
REQUIRE_SHARED_JWT_KEY=false

# === NVD API (EPSS + CVE Lookups) ===
# Get a free key at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# === Webhook Integrations ===
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# === Firmware Storage (S3-compatible) ===
S3_ENDPOINT=
S3_BUCKET=seagles-firmware
S3_ACCESS_KEY=
S3_SECRET_KEY=

# === Performance & Scaling ===
REDIS_URL=
RATE_LIMIT_PER_MIN=60
SCAN_MAX_CONCURRENT=20
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=5

# === Logging ===
LOG_LEVEL=info

# Comma-separated allowed origins for CORS and WebSocket (e.g. http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000

# Upstream the frontend's nginx uses to proxy /api/ to the Go backend.
# docker-compose sets this for you to http://backend:8080 (the Compose service
# name). In Kubernetes it must be the Service DNS name, e.g.
# http://seagles-backend.<namespace>.svc.cluster.local:8080
# If it is unset, nginx fails to start with 'unknown "SEAGLES_BACKEND" variable'.
#SEAGLES_BACKEND=http://backend:8080

# Grafana admin password (default: admin)
GRAFANA_PASSWORD=admin

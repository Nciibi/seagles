{
  "title": "Security Overview",
  "uid": "seagles-security-overview",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "panels": [
    {
      "title": "Total Devices",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 3, "h": 4},
      "targets": [{"expr": "seagles_uptime_seconds", "legendFormat": ""}],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green"}]}
        }
      }
    },
    {
      "title": "Critical Vulns",
      "type": "stat",
      "gridPos": {"x": 3, "y": 0, "w": 3, "h": 4},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red"}]}
        }
      }
    },
    {
      "title": "Open Alerts",
      "type": "stat",
      "gridPos": {"x": 6, "y": 0, "w": 3, "h": 4},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "orange"}]}
        }
      }
    },
    {
      "title": "Avg Risk Score",
      "type": "stat",
      "gridPos": {"x": 9, "y": 0, "w": 3, "h": 4},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"value": 0, "color": "green"},
            {"value": 3, "color": "blue"},
            {"value": 6, "color": "orange"},
            {"value": 8, "color": "red"}
          ]}
        }
      }
    },
    {
      "title": "Request Rate",
      "type": "graph",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "rate(seagles_requests_total[5m])", "legendFormat": "{{endpoint}}"}]
    },
    {
      "title": "Error Rate by Status",
      "type": "graph",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "rate(seagles_errors_total[5m])", "legendFormat": "{{error}}"}]
    },
    {
      "title": "Active Requests",
      "type": "gauge",
      "gridPos": {"x": 0, "y": 20, "w": 4, "h": 5},
      "targets": [{"expr": "seagles_requests_active", "legendFormat": "active"}]
    },
    {
      "title": "Request Latency (avg)",
      "type": "graph",
      "gridPos": {"x": 4, "y": 20, "w": 8, "h": 5},
      "targets": [{"expr": "seagles_request_latency_seconds", "legendFormat": "{{endpoint}}"}]
    }
  ],
  "rows": [],
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {"refresh_intervals": ["5s", "30s", "1m", "5m", "15m"]}
}

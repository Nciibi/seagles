server {
    # Unprivileged port. The Kubernetes manifest runs with
    # capabilities.drop: [ALL], which removes CAP_NET_BIND_SERVICE, so
    # listening on 80 fails with "bind() ... Permission denied" and the pod
    # CrashLoops. The Service and the compose port mapping publish this
    # externally (host 3000 in compose, Service port in Kubernetes), so
    # operators are unaffected.
    listen 8080;
    server_name localhost;
    # Must match the backend's 100MB cap (api/router.go) and the ingress
    # proxy-body-size. A larger value only defers the 413 to the backend.
    client_max_body_size 100M;
    root /usr/share/nginx/html;
    index index.html;

    # The API sets these headers on its own responses, but the HTML document
    # is served here. Without them the SPA has no CSP or clickjacking defence.
    # 'unsafe-inline' for style is required by the component style attributes;
    # script-src stays strict, so it does not re-enable inline JavaScript.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws: wss:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Serve React app
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to the Go backend.
    #
    # SEAGLES_BACKEND is substituted at container start by the nginx image's
    # envsubst entrypoint. It must be set:
    #   compose -> http://backend:8080
    #   k8s     -> http://seagles-backend.<ns>.svc.cluster.local:8080
    # It was previously hardcoded to "backend", which is the Docker Compose
    # service name only, so every /api/ request from the Kubernetes frontend
    # returned 502.
    #
    # If it is unset, the entrypoint's envsubst leaves "${SEAGLES_BACKEND}"
    # untouched (it only substitutes variables that exist in the environment),
    # nginx then fails to parse the config with 'unknown "SEAGLES_BACKEND"
    # variable' and exits. That is deliberate: a misconfiguration is loudly
    # visible as a CrashLoop rather than a silent 502 on every API call.
    location /api/ {
        proxy_pass ${SEAGLES_BACKEND}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Firmware uploads are up to 100M. nginx's default proxy_read_timeout
        # is 60s, which cuts off a large upload mid-transfer and returns 504
        # to the browser.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 1y;
        # add_header at this level replaces inherited ones, so repeat them.
        add_header Cache-Control "public, immutable" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws: wss:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
}
